# Copy to .env for local development:  cp .env.example .env
# .env is gitignored. These local values are not secrets; they match docker-compose.yml.
# Production values (Neon) are set in Vercel, never in a file.

# Used by the app (npm run dev) and by drizzle-kit (npm run db:migrate).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/feature_requests_dev

# Used by integration tests, which may wipe tables. Never point this at real data.
TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/feature_requests_test

# Better Auth signs session cookies with this. Generate your own; never commit it:
#   openssl rand -base64 32
# Production and Preview each have their own value, set in Vercel.
BETTER_AUTH_SECRET=

# Where the app runs. Production sets its real address in Vercel; previews leave it unset.
BETTER_AUTH_URL=http://localhost:3000
